# PayChaos AI — environment variable reference
#
# This file is committed to Git and must contain ONLY variable names and
# safe placeholder values — never a real Supabase URL, anon key, service
# role key, Razorpay secret, webhook secret, or any other credential.
# See docs/SECURITY.md ENV-004.
#
# Copy this file to .env.local and fill in real values for local
# development. .env.local is git-ignored and must never be committed.
#
# Phase 2A adds the Razorpay Test Mode variables below (server-only
# configuration/validation only — no Razorpay API/SDK calls yet).
# RAZORPAY_WEBHOOK_SECRET is configured manually by the developer once the
# Razorpay Dashboard webhook is set up (Phase 2G manual step) and is
# intentionally not listed here — it is validated lazily on first webhook
# request (lib/config/razorpay-webhook-env.ts), not at server startup.
# Phase 2G readiness adds the three PAYCHAOS_ACCESS_* variables below (the
# minimal operator access gate, docs/SECURITY.md Section 17) — also
# validated lazily, never required for ordinary local development.

# --- Client-safe (readable by the browser bundle) -------------------------
# Prefixed NEXT_PUBLIC_ so Next.js inlines them into client code at build
# time. The anon key is safe for untrusted clients under Supabase Row
# Level Security (RLS) — it carries no privileged authority by itself.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-only (never sent to the browser) -------------------------------
# CRITICAL secret. Bypasses Row Level Security. Must remain server-side
# only — never imported by client code, never logged, never committed.
# See docs/SECURITY.md Section 8/10.

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Razorpay Test Mode (server-only; never sent to the browser) ----------
# RAZORPAY_MODE must be exactly "test" — a non-"test" value fails closed.
# RAZORPAY_KEY_ID must use the Test Mode "rzp_test_" prefix — a
# "rzp_live_" value fails closed (docs/SECURITY.md RZP-CRED-003).
# RAZORPAY_KEY_SECRET is a CRITICAL secret — never commit the real value,
# never prefix it NEXT_PUBLIC_, never send it to the browser.
# See docs/RAZORPAY_GUIDE.md Section 49/50, docs/SECURITY.md Section 7/19.

RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret

# --- Operator access gate (server-only; never sent to the browser) --------
# Required ONLY for a publicly reachable payment-enabled deployment
# (docs/SECURITY.md Section 17, docs/ARCHITECTURE.md ADR-A16). Leave
# PAYCHAOS_ACCESS_GATE unset (or "disabled") for trusted local development —
# the gate is then fully open and PAYCHAOS_ACCESS_TOKEN/PAYCHAOS_SESSION_SECRET
# are never read. Set PAYCHAOS_ACCESS_GATE=enabled before using any public
# deployment (e.g. a Vercel preview used for real Test Mode webhook
# verification); PAYCHAOS_ACCESS_TOKEN (>= 20 chars) and
# PAYCHAOS_SESSION_SECRET (>= 32 chars, must differ from the access token)
# then become required. Never store either value in localStorage.

PAYCHAOS_ACCESS_GATE=disabled
PAYCHAOS_ACCESS_TOKEN=your-high-entropy-operator-access-token
PAYCHAOS_SESSION_SECRET=your-high-entropy-session-signing-secret
